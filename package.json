{
	"name": "group-booking-tool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --run",
		"test:unit": "vitest run server --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"seed:admin": "node --env-file=.env --import tsx src/lib/server/seed-admin.ts",
		"anonymize": "node --env-file=.env --import tsx src/lib/server/run-anonymize.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^5.0.3",
		"auth": "^1.7.7",
		"better-auth": "~1.7.7",
		"dotenv": "^18.0.5",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"ics": "^3.12.1",
		"rrule": "^2.8.1"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
